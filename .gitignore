# ===================================================================
# Java + Spring .gitignore
# ===================================================================

# Compiled Java class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ===================================================================
# Build Tool Specific (Maven / Gradle)
# ===================================================================

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# Gradle
.gradle
build/

# Gradle Autogenerated files
bin/
out/

# Gradle cache
.gradletasknamecache

# = not clear if you should track these files
# gradle-wrapper.jar
# .mvn/wrapper/maven-wrapper.jar

# ===================================================================
# IDE Specific
# ===================================================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
atlassian-ide-plugin.xml
com.atlassian.clover/

# Eclipse
.classpath
.project
.settings/
.springBeans

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# ===================================================================
# Operating System Files & Temporary Files
# ===================================================================

# Mac
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp

# ===================================================================
# Sensitive Information
# ===================================================================

# Environment variables
.env
.env.local
.env.*.local

# Local application properties (use templates instead)
application-local.properties
application-dev.properties
application-prod.properties